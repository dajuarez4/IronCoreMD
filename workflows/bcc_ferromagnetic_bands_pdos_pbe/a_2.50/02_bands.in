&CONTROL
    calculation = 'bands'
    prefix = 'fe_bcc128_fm_a250'
    pseudo_dir = '../pseudo'
    outdir = './tmp'
    disk_io = 'low'
/
&SYSTEM
    ibrav = 0
    nat = 128
    ntyp = 1
    ecutwfc = 71.0
    ecutrho = 496.0
